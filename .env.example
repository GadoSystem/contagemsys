# URL do backend do Rebano. O ContagemSys usa o login existente do Rebano.
# O usuario entra com CPF + senha; o CPF e enviado ao POST /api/auth/login do
# Rebano, que verifica a senha. Nenhuma conexao com o PostgreSQL e necessaria.
# O agrupamento por fazenda do painel usa a propria API do Rebano (token do
# usuario logado, mantido so em memoria); nao ha variavel nova para isso.
REBANO_API_URL=http://localhost:5148

# Segredo usado apenas para as sessoes web do ContagemSys.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTAGEM_JWT_SECRET=TROQUE_POR_UM_SEGREDO_GRANDE

# A MESMA chave deve ser configurada no Rebano em ContagemApi:IntegrationKey.
CONTAGEM_INTEGRATION_KEY=TROQUE_POR_UMA_CHAVE_DE_INTEGRACAO

# Login da pagina /admin do ContagemSys.
CONTAGEM_ADMIN_USER=admin
CONTAGEM_ADMIN_PASSWORD=TROQUE_A_SENHA_DO_ADMIN
